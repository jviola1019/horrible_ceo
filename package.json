{
  "name": "horrible-ceo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first satirical corporate strategy game",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit": "node tests/monte-carlo.mjs",
    "test:browser": "python3 tests/browser-smoke.py",
    "serve": "python3 -m http.server 8080",
    "build:single": "python3 tools/build_singlefile.py",
    "build:site": "python3 tools/build_site.py",
    "build": "npm run build:single && npm run build:site"
  },
  "engines": {
    "node": ">=20"
  }
}
